# Stripe
STRIPE_SECRET_KEY=rk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend (email)
RESEND_API_KEY=re_...

# App URL — cambiar a https://contratos.renters.mx en producción
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin panel (Basic Auth)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave-en-produccion

# Cron de recuperación de checkouts abandonados (Vercel lo manda como Bearer token)
CRON_SECRET=genera-un-secreto-aleatorio-largo

# Analytics — opcionales; si están vacíos los scripts no se cargan
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# Correo que recibe notificación en cada venta (opcional; default renters.mx@gmail.com)
SALE_NOTIFICATION_EMAIL=
